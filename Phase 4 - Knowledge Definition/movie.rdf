        <rdfs:domain rdf:resource="http://example.org/movie-domain#Actor"/>
        <rdfs:range rdf:resource="http://example.org/movie-domain#Movie"/>
        <rdfs:label>acted in</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://example.org/movie-domain#directedBy -->

