movies_clean["release_year"] = safe_int(movies_clean[year_col])

# 4.3 Rating стандарчлах (float)
movies_clean["rating"] = to_float(movies_clean[rating_col])

# 4.4 Runtime стандарчлах (integer minutes)
movies_clean["runtime_minutes"] = movies_clean[runtime_col].map(parse_runtime_to_minutes).astype("Int64")

# 4.5 Найруулагч / компани текст цэвэрлэх + нормчилсон хувилбар гаргах
movies_clean["director_name"] = movies_clean[director_col].map(norm_text)
movies_clean["director_norm"] = movies_clean["director_name"].map(norm_name)

movies_clean["company_name"] = movies_clean[company_col].map(norm_text)
movies_clean["company_norm"] = movies_clean["company_name"].map(norm_name)

